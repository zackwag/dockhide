#!/usr/bin/env bash
# dockhide — hide (or restore) any macOS app's Dock icon by setting
# LSUIElement in its Info.plist and ad-hoc re-signing the bundle.

set -euo pipefail

VERSION="0.0.0" # x-release-please-version

PLISTBUDDY=/usr/libexec/PlistBuddy
LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
# Records the app's original LSUIElement value ("unset", "true" or "false") so
# `show` can restore it exactly, and so `list` can find apps dockhide changed.
MARKER_KEY="DockhideOriginalLSUIElement"
SEARCH_DIRS=("/Applications" "${HOME}/Applications")

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
RESET='\033[0m'

usage() {
  cat <<EOF
Usage: dockhide <command> [app ...]

Commands:
  hide <app>...     Hide the app's Dock icon (sets LSUIElement, re-signs ad hoc)
  show <app>...     Restore the app's original Dock behavior
  status <app>...   Show whether the app's Dock icon is hidden
  list              List apps hidden by dockhide
  help              Show this help
  version           Show the version

<app> is a path to a .app bundle, or a name searched for in /Applications
and ~/Applications (e.g. "CalDigit_Docking_Station_Utility").

App updates replace Info.plist, so re-run \`dockhide hide\` after updating
an app. Use \`dockhide list\` to see what dockhide changed.
EOF
}

info() { echo -e "$*"; }
warn() { echo -e "${YELLOW}warning:${RESET} $*" >&2; }
die() {
  echo -e "${RED}error:${RESET} $*" >&2
  exit 1
}

# Runs a command, escalating with sudo only when the bundle isn't writable
# by the current user (e.g. root-owned apps installed by a .pkg).
as_owner() {
  if [[ -w "$APP_PLIST" && -w "$APP" ]]; then
    "$@"
  else
    sudo "$@"
  fi
}

# Resolves a path or bare app name to an absolute .app bundle path.
resolve_app() {
  local arg="$1" name match dir

  if [[ -d "$arg" ]]; then
    (cd "$arg" && pwd -P)
    return
  fi

  name="$(basename "${arg%.app}").app"
  for dir in "${SEARCH_DIRS[@]}"; do
    [[ -d "$dir" ]] || continue
    # Apps like CalDigit's live in a vendor subfolder, so search a few levels down
    # without descending into bundles themselves.
    match=$(find "$dir" -maxdepth 3 -iname "$name" -type d -prune -print 2>/dev/null | head -n 1)
    if [[ -n "$match" ]]; then
      echo "$match"
      return
    fi
  done

  die "no app found for \"${arg}\" (looked in ${SEARCH_DIRS[*]})"
}

plist_get() {
  "$PLISTBUDDY" -c "Print :$1" "$APP_PLIST" 2>/dev/null || true
}

# Sets APP and APP_PLIST, refusing bundles that can't be safely modified.
load_app() {
  APP="$(resolve_app "$1")"
  APP_PLIST="${APP}/Contents/Info.plist"

  [[ "$APP" == *.app ]] || die "${APP} is not a .app bundle"
  [[ -f "$APP_PLIST" ]] || die "${APP} has no Contents/Info.plist"
  [[ "$APP" != /System/* ]] || die "${APP} is a system app protected by SIP"
}

refuse_unsafe() {
  if [[ -d "${APP}/Contents/_MASReceipt" ]]; then
    die "${APP} is from the Mac App Store; re-signing it would stop it launching"
  fi
}

app_name() {
  basename "$APP" .app
}

is_running() {
  pgrep -qf "${APP}/Contents/MacOS/" 2>/dev/null
}

# Ad-hoc re-signs the bundle (editing Info.plist invalidates its signature) and
# re-registers it so Launch Services picks up the new LSUIElement value.
resign() {
  as_owner codesign --force --deep --sign - "$APP" 2>/dev/null ||
    die "codesign failed for ${APP}"
  "$LSREGISTER" -f "$APP" >/dev/null 2>&1 || true
}

restart_hint() {
  if is_running; then
    warn "$(app_name) is running; quit and reopen it for the change to take effect."
  fi
}

cmd_hide() {
  local current
  load_app "$1"
  refuse_unsafe

  current="$(plist_get LSUIElement)"
  if [[ "$current" == "true" ]]; then
    info "$(app_name): already hidden from the Dock"
    return
  fi

  if [[ -z "$(plist_get "$MARKER_KEY")" ]]; then
    as_owner "$PLISTBUDDY" -c "Add :${MARKER_KEY} string ${current:-unset}" "$APP_PLIST"
  fi

  if [[ -n "$current" ]]; then
    as_owner "$PLISTBUDDY" -c "Set :LSUIElement true" "$APP_PLIST"
  else
    as_owner "$PLISTBUDDY" -c "Add :LSUIElement bool true" "$APP_PLIST"
  fi

  resign
  info "${GREEN}✓${RESET} $(app_name): hidden from the Dock"
  restart_hint
}

cmd_show() {
  local original
  load_app "$1"

  original="$(plist_get "$MARKER_KEY")"
  if [[ -z "$original" ]]; then
    if [[ "$(plist_get LSUIElement)" == "true" ]]; then
      die "$(app_name) was already hidden before dockhide (by the app or by hand); not changing it"
    fi
    info "$(app_name): not hidden by dockhide"
    return
  fi

  refuse_unsafe
  case "$original" in
    unset) as_owner "$PLISTBUDDY" -c "Delete :LSUIElement" "$APP_PLIST" 2>/dev/null || true ;;
    *) as_owner "$PLISTBUDDY" -c "Set :LSUIElement ${original}" "$APP_PLIST" ;;
  esac
  as_owner "$PLISTBUDDY" -c "Delete :${MARKER_KEY}" "$APP_PLIST"

  resign
  info "${GREEN}✓${RESET} $(app_name): Dock icon restored"
  restart_hint
}

cmd_status() {
  load_app "$1"

  if [[ -n "$(plist_get "$MARKER_KEY")" ]]; then
    if [[ "$(plist_get LSUIElement)" == "true" ]]; then
      info "$(app_name): ${BOLD}hidden${RESET} (by dockhide)"
    else
      info "$(app_name): ${BOLD}visible${RESET} (dockhide marker present; run \`dockhide hide\` again)"
    fi
  elif [[ "$(plist_get LSUIElement)" == "true" ]]; then
    info "$(app_name): ${BOLD}hidden${RESET} (not by dockhide)"
  else
    info "$(app_name): ${BOLD}visible${RESET}"
  fi
}

cmd_list() {
  local dir app found=0
  for dir in "${SEARCH_DIRS[@]}"; do
    [[ -d "$dir" ]] || continue
    while IFS= read -r -d '' app; do
      if "$PLISTBUDDY" -c "Print :${MARKER_KEY}" "${app}/Contents/Info.plist" >/dev/null 2>&1; then
        echo "$app"
        found=1
      fi
    done < <(find "$dir" -maxdepth 3 -name "*.app" -type d -prune -print0 2>/dev/null)
  done
  [[ "$found" -eq 1 ]] || info "No apps hidden by dockhide."
}

main() {
  [[ "$(uname -s)" == "Darwin" ]] || die "dockhide only runs on macOS"

  local cmd="${1:-help}"
  [[ $# -gt 0 ]] && shift

  case "$cmd" in
    hide | show | status)
      [[ $# -gt 0 ]] || die "\`dockhide ${cmd}\` needs at least one app"
      local app rc=0
      for app in "$@"; do
        # Run each app in its own subshell so one failure doesn't stop the rest.
        # (Not `( ... ) || rc=1`: that context would disable set -e inside it.)
        local status
        set +e
        (
          set -e
          "cmd_${cmd}" "$app"
        )
        status=$?
        set -e
        [[ "$status" -eq 0 ]] || rc=1
      done
      exit "$rc"
      ;;
    list) cmd_list ;;
    help | -h | --help) usage ;;
    version | -v | --version) echo "dockhide ${VERSION}" ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
